# Copy to .env and fill in. NEVER commit .env.

PORT=8080
NODE_ENV=development

# ---- Supabase ----
SUPABASE_URL=https://rujemygoawvemvwewplq.supabase.co
# Dashboard > Project Settings > API Keys > "Secret keys" (SERVER ONLY, never in frontend)
SUPABASE_SERVICE_ROLE_KEY=
# LEAVE BLANK if your project uses asymmetric JWT signing keys (ECC P-256 / ES256) —
# which is the default for new projects. The backend then verifies user JWTs against the
# public JWKS at $SUPABASE_URL/auth/v1/.well-known/jwks.json and needs no secret here.
# Only set this if your project still uses a legacy shared HMAC JWT secret (HS256).
SUPABASE_JWT_SECRET=

# ---- Cardano (preprod ONLY) ----
# https://blockfrost.io > create a PREPROD project > copy the project id
BLOCKFROST_PROJECT_ID=
CARDANO_NETWORK=preprod
# 24-word mnemonic for the service wallet. Generate with: npm run wallet:new
SERVICE_WALLET_MNEMONIC=

# ---- Patient QR token ----
# Any long random string, e.g. `openssl rand -hex 32`
QR_TOKEN_SECRET=
QR_TOKEN_TTL_SECONDS=30
