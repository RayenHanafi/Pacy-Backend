{
  "name": "pacy-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Pacy backend — prescription tokenization on Cardano preprod",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/seed.ts",
    "stations:rotate": "tsx scripts/rotate-station-keys.ts",
    "spike": "tsx scripts/spike.ts",
    "wallet:new": "tsx scripts/new-wallet.ts",
    "e2e:phase3": "tsx scripts/e2e-phase3.ts",
    "e2e:phase4": "tsx scripts/e2e-phase4.ts",
    "e2e:phase5": "tsx scripts/e2e-phase5.ts",
    "e2e:lists": "tsx scripts/e2e-lists.ts",
    "seed:expired": "tsx scripts/seed-demo-expired.ts",
    "verify": "tsx scripts/verify-onchain.ts",
    "onchain:wallets": "tsx onchain/offchain/gen-wallets.ts",
    "onchain:prep": "tsx onchain/offchain/prep.ts",
    "onchain:spike": "tsx onchain/offchain/spike.ts",
    "onchain:spike2": "tsx onchain/offchain/spike2.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@meshsdk/core": "^1.9.1",
    "@supabase/supabase-js": "^2.110.7",
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "jose": "^6.2.3",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
